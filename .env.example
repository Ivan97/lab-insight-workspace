# Which provider dialect controls thinking. Unknown values fail loudly at
# request time rather than silently leaving the toggle unwired.
#   deepseek - verified against https://api.deepseek.com/v1
#   gemini   - OpenAI-compatibility endpoint, not yet verified against a live key
#   openai   - generic OpenAI-compatible endpoint, reasoning_effort only
#   kimi     - no verified thinking switch; the toggle only swaps model ids
LLM_PROVIDER=deepseek

# DeepSeek example: https://api.deepseek.com/v1
# Kimi example:     https://api.moonshot.cn/v1
# Gemini example:   https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# The composer toggle picks between these two. DeepSeek v4 is a hybrid model,
# so both may be the same id and the thinking switch does the work. A provider
# without a thinking switch needs two different ids here instead.
LLM_THINKING_MODEL=deepseek-v4-flash
LLM_NON_THINKING_MODEL=deepseek-v4-flash

# Applied only when thinking is on. DeepSeek accepts all of:
#   none, minimal, low, medium, high, xhigh, max
# Gemini and OpenAI expose fewer levels; a level they lack is translated to
# their nearest supported one rather than dropped.
LLM_REASONING_EFFORT=high

# Agent Skills are folders under this directory, each holding a SKILL.md with
# YAML frontmatter (Agent Skills specification). Discovery and progressive
# disclosure come from deepagents' SkillsMiddleware.
SKILL_DIR=skill

# Skills may ship scripts, so the agent gets an `execute` tool by default.
# Rooting the file tools at SKILL_DIR bounds their paths, but a shell command
# is not sandboxed: it can do anything the server user can. Set to false to
# leave the agent with read-only file access to skills.
SKILL_EXECUTE_ENABLED=true
